# FreightQuote AI — Environment Variable Template
# Copy this file to .env and fill in YOUR OWN values.
# NEVER commit the real .env file — it must stay in .gitignore.

# --- Model Access ---
HF_TOKEN=                          # Hugging Face access token (to download Qwen2.5 model weights)

# --- Dataset Access (if applicable) ---
KAGGLE_USERNAME=                   # Kaggle API username
KAGGLE_KEY=                        # Kaggle API key

# --- OTP / Email (use a dedicated project mailbox, NOT a personal account) ---
OTP_EMAIL_ADDRESS=                 # Sending mailbox for OTP emails
OTP_EMAIL_APP_PASSWORD=            # Gmail App Password (NOT your real account password)

# --- Auth ---
JWT_SECRET_KEY=                    # Generate with: python -c "import secrets;print(secrets.token_hex(32))"
